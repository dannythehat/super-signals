# Local API configuration only. Copy to .env and never commit the real file.
SUPER_SIGNALS_ENV=development
DATABASE_URL=postgresql+psycopg://super_signals:super_signals@127.0.0.1:5432/super_signals
SUPER_SIGNALS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SUPER_SIGNALS_SESSION_COOKIE=super_signals_session
SUPER_SIGNALS_SESSION_TTL_SECONDS=28800
SUPER_SIGNALS_RECOVERY_TTL_SECONDS=1800
SUPER_SIGNALS_COOKIE_SECURE=false
SUPER_SIGNALS_FINGERPRINT_SECRET=development-only-change-me
SUPER_SIGNALS_OWNER_EMAIL=owner@example.com
SUPER_SIGNALS_OWNER_DISPLAY_NAME=Owner
SUPER_SIGNALS_OWNER_PASSWORD=

# Server-only Telegram application credentials from my.telegram.org.
# Never expose these through VITE_ variables or commit real values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Use either explicit Fernet keys or one strong raw secret, never both.
# Hosted one-click deployment generates the raw secret automatically.
SUPER_SIGNALS_TELEGRAM_SESSION_KEYS=
SUPER_SIGNALS_TELEGRAM_SESSION_SECRET=
SUPER_SIGNALS_TELEGRAM_QR_TTL_SECONDS=120

# AI-authoritative Telegram message supervision. Keep the API key server-side only.
# OPENAI_API_KEY is canonical. The deployed service temporarily also accepts the
# existing Render variable named `Open` so that secret does not need to be exposed
# or copied during the Day 26 recovery.
OPENAI_API_KEY=
SUPER_SIGNALS_AI_SUPERVISOR_ENABLED=true
SUPER_SIGNALS_AI_SUPERVISOR_MODEL=gpt-5-mini-2025-08-07
SUPER_SIGNALS_AI_SUPERVISOR_TIMEOUT_SECONDS=12
# One-shot deployment verification only. Set to 1 temporarily, then return to 0.
SUPER_SIGNALS_AI_ACCEPTANCE_PROBE=0

# Public browser configuration. Never place secrets in VITE_ variables.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEPLOYMENT_ENV=local

# Hosting secrets remain blank in this example and belong in encrypted secret stores.
CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
MT5_INTEGRATION_TOKEN=
