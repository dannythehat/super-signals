{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-signals",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build:web"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  }
}
