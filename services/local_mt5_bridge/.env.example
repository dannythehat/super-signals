# Copy this file to .env on the laptop. Never commit the real values.
SUPER_SIGNALS_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
SUPER_SIGNALS_LOCAL_BRIDGE_TOKEN=generate-a-random-secret-of-at-least-32-characters
SUPER_SIGNALS_LOCAL_BRIDGE_PROFILE=super-signals
SUPER_SIGNALS_LOCAL_BRIDGE_WORKER_ID=super-signals-thinkpad

# This is the existing account reference stored by Super Signals on Render.
SUPER_SIGNALS_LOCAL_BRIDGE_ACCOUNT_ID=

# These credentials stay only on the laptop.
SUPER_SIGNALS_MT5_TERMINAL_PATH=C:\Program Files\Vantage International MT5\terminal64.exe
SUPER_SIGNALS_MT5_LOGIN=
SUPER_SIGNALS_MT5_PASSWORD=
SUPER_SIGNALS_MT5_SERVER=

# Must be different from GoldThinker's magic number.
SUPER_SIGNALS_MT5_MAGIC=2601001
SUPER_SIGNALS_MT5_DEVIATION=20
SUPER_SIGNALS_LOCAL_BRIDGE_POLL_SECONDS=0.5
